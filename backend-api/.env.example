# --- App ---
APP_PORT=8080
APP_ENV=development
# Frontend origin allowed by CORS (required — change for deploy)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (required) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# --- Keycloak (required) ---
# Keep /auth when your Cloud-IAM admin URL contains it
KEYCLOAK_URL=https://<host>.cloud-iam.com/auth
KEYCLOAK_REALM=<your-realm>
KEYCLOAK_CLIENT_ID=cyberwatch-api

# --- Scan transport ---
# http  = call worker directly (dev)
# rabbitmq = publish to queue (prod-like)
SCAN_MODE=http
# Required when SCAN_MODE=http (no silent localhost default in code)
WORKER_URL=http://localhost:8001

# Required when SCAN_MODE=rabbitmq (never commit real credentials)
# RABBITMQ_URL=amqp://USER:PASSWORD@rabbitmq-host:5672/
RABBITMQ_EXCHANGE=cyberwatch.scans
RABBITMQ_QUEUE=scan_jobs
RABBITMQ_DEAD_LETTER_EXCHANGE=cyberwatch.scans.dlx
RABBITMQ_DEAD_LETTER_QUEUE=scan_dead_letter
RABBITMQ_ROUTING_KEY=scan.start
RABBITMQ_MAX_ATTEMPTS=3
