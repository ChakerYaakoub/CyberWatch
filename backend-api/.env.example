APP_PORT=8080
APP_ENV=development
CORS_ORIGIN=http://localhost:5173

# Required — no credentials are hardcoded in the application source.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# Hosted Keycloak (Cloud-IAM) — keep /auth when your admin URL contains it
KEYCLOAK_URL=https://<host>.cloud-iam.com/auth
KEYCLOAK_REALM=<your-realm>
KEYCLOAK_CLIENT_ID=cyberwatch-api

# Scan transport: http (dev) | rabbitmq (async)
SCAN_MODE=http
WORKER_URL=http://localhost:8001
# Required when SCAN_MODE=rabbitmq
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
