# --- Frontend (Vite) — all required for deploy ---
# API base URL including /api suffix
VITE_API_URL=http://localhost:8080/api

# Hosted Keycloak (Cloud-IAM) — keep /auth when admin URL contains it
VITE_KEYCLOAK_URL=https://<host>.cloud-iam.com/auth
VITE_KEYCLOAK_REALM=<your-realm>
VITE_KEYCLOAK_CLIENT_ID=cyberwatch-frontend

# Redirect URIs are derived from window.location.origin (no hardcoded localhost in code).
# In Keycloak, allow your real frontend origin, e.g. https://app.example.com/*
