# --- Worker (required for /jobs + DB writes) ---
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# Same PostgreSQL as Go API (DATABASE_PASSWORD is required — no empty default)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# RabbitMQ — required only when running: python -m app.consumer
# Do not use guest/guest in production
# RABBITMQ_URL=amqp://USER:PASSWORD@rabbitmq-host:5672/
QUEUE_NAME=scan_jobs
RABBITMQ_EXCHANGE=cyberwatch.scans
RABBITMQ_DEAD_LETTER_EXCHANGE=cyberwatch.scans.dlx
RABBITMQ_DEAD_LETTER_QUEUE=scan_dead_letter
RABBITMQ_ROUTING_KEY=scan.start
RABBITMQ_MAX_ATTEMPTS=3
