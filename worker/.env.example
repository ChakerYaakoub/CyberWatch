# Worker env example — copy to .env

APP_ENV=development
LOG_LEVEL=INFO
PORT=8001

# Same PostgreSQL as Go API (required for /jobs + RabbitMQ consumer)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# RabbitMQ (consumer only)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=scan_jobs
