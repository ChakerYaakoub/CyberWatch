# CyberWatch — EXAMPLE only (safe to commit).
# Copy to .env and replace every placeholder with your own values.
# Never put real Cloud-IAM hosts or production passwords in this file.
#
#   copy .env.example .env
#
# Used by: Docker Compose, Go API, worker, Vite (envDir → infrastructure/).

# --- App / API ---
APP_PORT=8080
APP_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Docker Compose overrides DATABASE_HOST → postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=REPLACE_WITH_DB_PASSWORD
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# --- Keycloak (Cloud-IAM, external) ---
# Example shape only — use YOUR deployment host + realm
KEYCLOAK_URL=https://YOUR_HOST.cloud-iam.com/auth
KEYCLOAK_REALM=YOUR_REALM
KEYCLOAK_CLIENT_ID=cyberwatch-api

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=https://YOUR_HOST.cloud-iam.com/auth
VITE_KEYCLOAK_REALM=YOUR_REALM
VITE_KEYCLOAK_CLIENT_ID=cyberwatch-frontend

# --- Worker ---
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# --- Scan transport ---
# http = worker POST /jobs · rabbitmq = queue (recommended with Docker)
SCAN_MODE=rabbitmq
WORKER_URL=http://localhost:8001

# --- RabbitMQ ---
# Compose creates this user and overrides RABBITMQ_URL host → rabbitmq
RABBITMQ_USER=cyberwatch
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://cyberwatch:REPLACE_WITH_RABBITMQ_PASSWORD@localhost:5672/
RABBITMQ_EXCHANGE=cyberwatch.scans
RABBITMQ_QUEUE=scan_jobs
QUEUE_NAME=scan_jobs
RABBITMQ_DEAD_LETTER_EXCHANGE=cyberwatch.scans.dlx
RABBITMQ_DEAD_LETTER_QUEUE=scan_dead_letter
RABBITMQ_ROUTING_KEY=scan.start
RABBITMQ_MAX_ATTEMPTS=3
