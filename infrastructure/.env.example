# CyberWatch — single env file for the whole platform.
# Copy:  copy .env.example .env
# Used by: Docker Compose, Go API, worker, Vite frontend (envDir).
# Never commit .env

# --- App / API ---
APP_PORT=8080
APP_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Docker Compose overrides DATABASE_HOST → postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=cyberwatch
DATABASE_SSLMODE=disable

# --- Keycloak (Cloud-IAM, external) ---
KEYCLOAK_URL=https://<host>.cloud-iam.com/auth
KEYCLOAK_REALM=<your-realm>
KEYCLOAK_CLIENT_ID=cyberwatch-api

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=https://<host>.cloud-iam.com/auth
VITE_KEYCLOAK_REALM=<your-realm>
VITE_KEYCLOAK_CLIENT_ID=cyberwatch-frontend

# --- Worker ---
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# --- Scan transport ---
# http = worker POST /jobs · rabbitmq = queue (recommended with Docker)
SCAN_MODE=rabbitmq
WORKER_URL=http://localhost:8001

# --- RabbitMQ ---
# Compose creates the broker user and overrides RABBITMQ_URL host → rabbitmq
RABBITMQ_USER=cyberwatch
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://cyberwatch:change_me@localhost:5672/
RABBITMQ_EXCHANGE=cyberwatch.scans
RABBITMQ_QUEUE=scan_jobs
QUEUE_NAME=scan_jobs
RABBITMQ_DEAD_LETTER_EXCHANGE=cyberwatch.scans.dlx
RABBITMQ_DEAD_LETTER_QUEUE=scan_dead_letter
RABBITMQ_ROUTING_KEY=scan.start
RABBITMQ_MAX_ATTEMPTS=3
